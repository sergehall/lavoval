root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Go uses tabs — enforced by gofmt
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require hard tabs
[Makefile]
indent_style = tab
indent_size = 4

# YAML — 2-space indent is the convention
[*.{yml,yaml}]
indent_size = 2

# Markdown — preserve trailing spaces (line breaks)
[*.md]
trim_trailing_whitespace = false
