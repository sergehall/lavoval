{
  "name": "lavoval",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.0.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose --env-file .env.local up -d",
    "infra:down": "docker compose --env-file .env.local down",
    "infra:logs": "docker compose --env-file .env.local logs -f",
    "db:migrate": "bash ./scripts/db-migrate.sh",
    "db:migrate:prod": "bash ./scripts/db-migrate-prod.sh",
    "db:migrate:status": "bash ./scripts/db-migrate-status.sh",
    "db:seed": "bash ./scripts/db-seed.sh",

    "dev": "pnpm run dev:stack",
    "lavoval": "node --experimental-strip-types ./packages/cli/src/index.ts",
    "dev:stack": "node ./scripts/dev-stack.mjs",
    "dev:stack:stop": "node ./scripts/dev-stack-stop.mjs",
    "dev:web": "LAVOVAL_ENV_PROFILE=dev bash ./scripts/run-web.sh dev dev",
    "dev:web:prod-api": "NEXT_PUBLIC_APP_URL=https://lavoval.com NEXT_PUBLIC_API_URL=https://api.lavoval.com LAVOVAL_ENV_PROFILE=production bash ./scripts/run-web.sh production dev",
    "dev:api": "LAVOVAL_ENV_PROFILE=dev bash ./scripts/run-api.sh dev",
    "prod:local:web": "LAVOVAL_ENV_PROFILE=prod-local bash ./scripts/run-web.sh prod-local prod",
    "prod:local:api": "LAVOVAL_ENV_PROFILE=prod-local bash ./scripts/run-api.sh prod-local",

    "build": "pnpm run build:web",
    "build:web": "pnpm --dir apps/web build",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "check:web": "pnpm run lint:web && pnpm run test:web && pnpm run typecheck:web",

    "test": "pnpm run test:web && pnpm run test:api",
    "test:web": "pnpm --dir apps/web test",
    "test:api": "cd apps/api && go test ./...",

    "lint": "pnpm run lint:web && pnpm run lint:api",
    "lint:web": "pnpm --dir apps/web lint",
    "lint:api": "cd apps/api && test -z \"$(gofmt -l .)\" && go vet ./... && go test ./...",
    "lint:fix": "pnpm run lint:fix:web && pnpm run lint:fix:api",
    "lint:fix:web": "pnpm --dir apps/web lint:fix",
    "lint:fix:api": "cd apps/api && gofmt -w .",

    "format": "pnpm run format:web && pnpm run format:api",
    "format:web": "pnpm --filter @lavoval/web format",
    "format:api": "cd apps/api && gofmt -w .",
    "format:check": "pnpm run format:check:web && pnpm run format:check:api",
    "format:check:web": "pnpm --dir apps/web exec prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:check:api": "cd apps/api && test -z \"$(gofmt -l .)\""
  }
}
