# Base runtime profile (.env)
APP_ENV=development
APP_NAME="Lavoval"
APP_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_HTTP_ADDR=:8080
DATABASE_URL=postgres://lavoval:lavoval@postgres:5432/lavoval?sslmode=disable
POSTGRES_DB=lavoval
POSTGRES_USER=lavoval
POSTGRES_PASSWORD=lavoval
JWT_ISSUER=lavoval
JWT_AUDIENCE=lavoval-web
JWT_SECRET=change-me-to-a-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
ADMIN_SEED_EMAIL=admin@lavoval.local
ADMIN_SEED_PASSWORD=ChangeMe123!
EMAIL_VERIFICATION_TTL=24h
OAUTH_STATE_TTL=10m
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-google-account@gmail.com
SMTP_FROM_NAME=Lavoval
SMTP_REQUIRE_TLS=true
SMTP_ALLOW_INSECURE_AUTH=false
# SMTP_USE_SSL=false  # Set to true for port 465 (implicit TLS), leave false for port 587 (STARTTLS)
MAIL_PROVIDER=smtp
MAIL_SEND_TIMEOUT=15s
MAIL_WORKER_COUNT=4
MAIL_MAX_ATTEMPTS=4
MAIL_RETRY_BASE_DELAY=1s
MAIL_POLL_INTERVAL=500ms
MAIL_LEASE_TTL=30s
MAIL_RATE_LIMIT_PER_SECOND=0
MAIL_RATE_LIMIT_BURST=1
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_API_USER=me
# GMAIL_API_ACCESS_TOKEN=ya29.your-google-access-token
# GMAIL_API_REFRESH_TOKEN=your-google-oauth-refresh-token
# GMAIL_API_CLIENT_ID=your-google-oauth-client-id
# GMAIL_API_CLIENT_SECRET=your-google-oauth-client-secret
# GMAIL_API_TOKEN_URL=https://oauth2.googleapis.com/token

# Local docker / localhost overrides (.env.local)
# Example values:
# APP_ENV=development
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8080
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# POSTGRES_DB=lavoval
# POSTGRES_USER=lavoval
# POSTGRES_PASSWORD=lavoval
# DATABASE_URL=postgres://lavoval:lavoval@localhost:5432/lavoval?sslmode=disable
