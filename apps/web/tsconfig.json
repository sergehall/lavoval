{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@lavoval/contracts": ["../../packages/contracts/src/index.ts"],
      "@lavoval/contracts/runtime": ["../../packages/contracts/src/runtime.ts"],
      "@lavoval/engine": ["../../packages/engine/src/index.ts"],
      "@lavoval/registry": ["../../packages/registry/src/index.ts"],
      "@lavoval/sdk": ["../../packages/sdk/src/index.ts"],
      "zod": ["../../node_modules/zod"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
